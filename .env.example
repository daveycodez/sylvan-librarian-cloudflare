# ── Sylvan Librarian on Cloudflare ────────────────────────────────────────────
# Deploy model: create a Worker in the Cloudflare dashboard → connect this git
# repo (Workers Builds) → set the variables below → deploy. First request
# auto-bootstraps the card index (an import container builds the store into R2);
# the site serves a "building index" page until it finishes (~a few minutes).
# After that, a nightly cron refreshes the store from Scryfall bulk data.
#
# Set these in the Cloudflare dashboard under Worker → Settings → Variables
# (or `wrangler secret put <NAME>` if deploying from a terminal). This file is
# documentation only — nothing reads .env at runtime.

# ── Secrets (encrypted) ───────────────────────────────────────────────────────

# R2 S3-API credentials used by the import container to upload the built store.
# Create under Cloudflare dashboard → R2 → Manage R2 API Tokens →
# "Object Read & Write", scoped to the bucket below.
R2_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Your Cloudflare account id (dashboard → Workers & Pages → right sidebar).
# Used by the import container to reach the R2 S3 endpoint:
# https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com
CF_ACCOUNT_ID=

# OPTIONAL: trusted-caller bypass for the built-in per-IP rate limit.
# Unset (the default) = no bypass exists. Set it, and requests carrying a
# matching `x-sylvan-api-key` header skip the limiter — for your own
# server-to-server callers, whose traffic funnels through shared egress IPs
# and must not be counted per-IP. Generate one: openssl rand -hex 32
TRUSTED_API_KEY=

# ── Plain variables ───────────────────────────────────────────────────────────

# Per-IP rate limiting on the engine routes (token bucket in a per-IP
# Durable Object — globally exact). OFF unless RATE_LIMIT_ENABLED=true is
# set. Both are runtime vars: change them in the dashboard, no redeploy.
# RATE_LIMIT_PER_10S defaults to 100 when unset.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_10S=100

# R2 bucket holding the engine store. Must match wrangler.jsonc's
# r2_buckets[].bucket_name. Created automatically on first deploy if your
# account allows provisioning; otherwise create it once: R2 → Create bucket.
R2_BUCKET=sylvan-librarian
