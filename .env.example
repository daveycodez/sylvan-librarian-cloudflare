# ── Sylvan Librarian on Cloudflare ────────────────────────────────────────────
# Deploy model: create a Worker in the Cloudflare dashboard → connect this git
# repo (Workers Builds) → deploy. That's it — no secrets, no payment method,
# no build variables. The D1 database is provisioned on first deploy (or
# create it once with `wrangler d1 create sylvan-librarian` and put its id in
# wrangler.jsonc). The first request auto-bootstraps the card index: the
# ImportCoordinator Durable Object streams Scryfall bulk data, builds the
# engine store in wasm, and publishes it to D1 (~10-20 minutes, once); the
# site serves a "building index" page until it finishes. After that, a
# nightly cron refreshes the store.
#
# Everything below is OPTIONAL. Set in the Cloudflare dashboard under
# Worker → Settings → Variables (or `wrangler secret put <NAME>`). This file
# is documentation only — nothing reads .env at runtime.

# ── Optional secrets ──────────────────────────────────────────────────────────

# Trusted-caller bypass for the built-in per-IP rate limit. Unset (the
# default) = no bypass exists. Set it, and requests carrying a matching
# `X-API-Key` header skip the limiter — for your own server-to-server
# callers, whose traffic funnels through shared egress IPs and must not be
# counted per-IP. Generate one: openssl rand -hex 32
TRUSTED_API_KEY=

# ── Optional plain variables ──────────────────────────────────────────────────

# Per-IP rate limiting on the engine routes (token bucket in a per-IP
# Durable Object — globally exact). OFF unless RATE_LIMIT_ENABLED=true is
# set. Both are runtime vars: change them in the dashboard, no redeploy.
# RATE_LIMIT_PER_10S defaults to 100 when unset.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_10S=100

# Cap on per-colo engine fan-out (default 8). On the free plan consider 1-2:
# each warm shard holds a ~70MB store copy against the 5GB account storage
# and duration allowances.
SHARDS_MAX=

# Fixed cap on metered D1 row writes per import run for the SQL-fallback
# cards table. UNSET (the default) = adaptive: the import writes until D1
# itself reports the free plan's daily-limit error, remembers where that
# ceiling sits, and paces under it on later runs (re-probed monthly). That
# means a paid plan fills the table in one run and a free plan self-paces
# off the real ~100k/day limit — no configuration either way. Set a number
# to override the adaptive pacing with a fixed per-run cap, or 0 to disable
# the fallback table entirely (engine-only deployment: queries the engine
# declines — measured at ~2% of upstream's test corpus, mostly regex
# constructs — return a structured error instead).
CARDS_WRITE_BUDGET=

# Point the import at a Scryfall bulk-data mirror (tests use a local fake).
SCRYFALL_BULK_URL=
