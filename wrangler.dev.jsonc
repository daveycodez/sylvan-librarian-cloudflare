{
	// LOCAL DEV config: kept in lockstep with wrangler.jsonc. With the import
	// running inside a Durable Object (wasm) against local simulated KV, dev
	// is production-identical — wrangler dev emulates KV, DO SQLite, and
	// alarms natively, so even the import pipeline runs locally unchanged. The KV id is a local placeholder: miniflare keys its
	// simulated namespace by binding name, never contacting the real one.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sylvan-librarian",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },

	// Static assets, served straight from Cloudflare's CDN out of public/ —
	// app.js, app.min.js, card.js, styles.css, the icons, robots.txt and the
	// tuner page. A request matching one of these NEVER invokes the Worker: no
	// isolate start, no CPU, and it does not count against the Worker request
	// budget. They also leave the script entirely, which is the point: they were
	// a ~313KB text module inside it, and script size costs isolate startup at
	// roughly 1.5ms per 100KB — a cost every /search was paying to carry files
	// it never reads (measured: 313KB 10-13ms, 0.5KB 7ms, empty Worker 5ms).
	//
	// html_handling "none" so nothing is rewritten under this Worker's own
	// paths, and not_found_handling "none" so anything that is not an asset
	// falls through to the router, which owns the 404.
	"assets": {
		"directory": "./public",
		"html_handling": "none",
		"not_found_handling": "none"
	},
	"cache": { "enabled": true },
	"kv_namespaces": [
		{
			"binding": "STORE_KV",
			"id": "sylvan-librarian-store-local"
		}
	],
	"durable_objects": {
		"bindings": [
			{ "name": "IMPORT_COORDINATOR", "class_name": "ImportCoordinator" },
			{ "name": "SEARCH_ENGINE", "class_name": "SearchEngine" },
			// Per-IP token-bucket rate limiter (one tiny in-memory DO per IP);
			// limits are runtime env vars — see RATE_LIMIT_* in .env.example.
			{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ImportCoordinator"] },
		{ "tag": "v2", "new_sqlite_classes": ["SearchEngine"] },
		{ "tag": "v3", "new_sqlite_classes": ["RateLimiter"] }
	],
	"triggers": { "crons": ["17 11 * * *"] },
	"alias": {
		"sylvan-engine-wasm": "./src/engine/wasm-shim.ts"
	},
	"rules": [
		{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
		{ "type": "Text", "globs": ["**/*.css", "**/*.html", "**/*.txt"], "fallthrough": true },
		{ "type": "Data", "globs": ["**/*.ico", "**/*.webp"], "fallthrough": true }
	]
}
