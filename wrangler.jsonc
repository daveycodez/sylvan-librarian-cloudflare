{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sylvan-librarian",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },

	// Workers Cache: regionally tiered cache in front of the Worker, honoring
	// the Cache-Control headers the routes already mirror from upstream
	// (statics 30d/1h, pages+catalog 1h, /search 90s). Hits skip the Worker —
	// and therefore cold isolate starts — entirely. no-store responses
	// (random_search, bootstrap page) and error statuses are never cached, so
	// the honest-failure invariants hold. Per-version cache (default): each
	// deploy starts fresh, so statics can't go stale across releases. Nightly
	// imports need no purge: /search's 90s TTL is smaller than the isolates'
	// own manifest-poll staleness, and page HTML carries no card data.
	"cache": { "enabled": true },

	// The engine store + version manifest live here. The import container writes
	// via the R2 S3 API; the Worker reads via this binding.
	"r2_buckets": [
		{
			"binding": "STORE",
			"bucket_name": "sylvan-librarian"
		}
	],

	// ImportCoordinator is a container-enabled Durable Object: it serializes
	// import runs (only one at a time), starts the container, and records the
	// last run's outcome. The Worker talks to a single named instance.
	// Per-IP rate limit on the engine-computing routes (see src/routes/rate-limit.ts).
	// 100 req/10s per IP: generous for many people behind one shared IP (CGNAT,
	// offices), a wall for scripts. Tune limit/period here; requests carrying a
	// matching x-sylvan-api-key header (TRUSTED_API_KEY secret) bypass it.
	"ratelimits": [
		{
			"name": "SEARCH_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 10 }
		}
	],

	"durable_objects": {
		"bindings": [
			{ "name": "IMPORT_COORDINATOR", "class_name": "ImportCoordinator" },
			{ "name": "SEARCH_ENGINE", "class_name": "SearchEngine" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ImportCoordinator"] },
		{ "tag": "v2", "new_sqlite_classes": ["SearchEngine"] }
	],
	"containers": [
		{
			"class_name": "ImportCoordinator",
			"image": "./Dockerfile",
			"max_instances": 1,
			// The store build peaks well above a Worker isolate's 128MB — that is
			// why the import is a container at all. standard-1 = 4GiB / 1/2 vCPU.
			"instance_type": "standard-1"
		}
	],

	// Nightly store rebuild, after Scryfall's daily bulk-data refresh window.
	"triggers": { "crons": ["17 11 * * *"] },

	// The wasm engine is imported by the module name the code uses; the built
	// wasm-bindgen pkg is committed so Workers Builds needs no Rust toolchain.
	"alias": {
		"sylvan-engine-wasm": "./src/engine/wasm-shim.ts"
	},

	// Bundle the wasm engine and the vendored upstream static assets.
	"rules": [
		{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
		{ "type": "Text", "globs": ["**/*.css", "**/*.html", "**/*.txt"], "fallthrough": true },
		{ "type": "Data", "globs": ["**/*.ico", "**/*.webp"], "fallthrough": true }
	],

	"vars": {
		// Documentation of expected plain vars; real values are set in the
		// dashboard (Workers Builds) or .dev.vars locally. Secrets (ADMIN_TOKEN,
		// R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, CF_ACCOUNT_ID) are never here.
		"R2_BUCKET": "sylvan-librarian"
	}
}
